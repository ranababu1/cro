<?xml version="1.0"?>
<ruleset name="FreeABTest">
	<file>freeabtest</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-8.3"/>
	<config name="minimum_wp_version" value="6.0"/>
	<rule ref="WordPress.WP.I18n"><properties><property name="text_domain" type="array"><element value="freeabtest"/></property></properties></rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals"><properties><property name="prefixes" type="array"><element value="freeabtest"/></property></properties></rule>
</ruleset>
