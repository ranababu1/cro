# Database. Local SQLite file by default. Use libsql://... plus a token for Turso in production.
DATABASE_URL=file:./data/cro.db
DATABASE_AUTH_TOKEN=
# Set to false to skip automatic migrations at startup (then run npm run db:migrate yourself)
DB_AUTO_MIGRATE=true

# Auth (next-auth with Google)
NEXTAUTH_URL=http://localhost:3000
# Public site origin used in install snippets (defaults to https://www.freeabtest.com)
NEXT_PUBLIC_APP_ORIGIN=
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile bot check before Google sign-in. Both must be set to turn it on;
# with either missing the check is skipped and a warning is logged.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Requests per minute per SDK key and client IP on /api/assign and /api/track
RATE_LIMIT_PER_MINUTE=600

# Platform super-admins (comma separated emails). They can open /admin to manage all tenants.
# This is separate from org roles. Leave empty to disable the admin console.
PLATFORM_ADMIN_EMAILS=
